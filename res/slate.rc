#include <winver.h>

1 ICON "slate.ico"
1 24 "slate.manifest"

// VER_MAJOR/MINOR/PATCH and VER_STR come from Cargo.toml via build.rs.
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Dexterity Design Services Pvt. Ltd."
      VALUE "FileDescription", "Slate text editor"
      VALUE "FileVersion", VER_STR
      VALUE "ProductName", "Slate"
      VALUE "ProductVersion", VER_STR
      VALUE "OriginalFilename", "slate.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
